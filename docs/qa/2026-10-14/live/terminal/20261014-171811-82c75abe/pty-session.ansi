      def text_box(slide, text, left, top, width, height, size, color, bold=False):[K
          shape = slide.shapes.add_textbox([K
              Inches(left), Inches(top), Inches(width), Inches(height)[K
          )[K
          frame = shape.text_frame[K
          frame.word_wrap = True[K
          paragraph = frame.paragraphs[0][K
          paragraph.text = text[K
          paragraph.font.name = "Aptos"[K
          paragraph.font.size = Pt(size)[K
          paragraph.font.bold = bold[K
          paragraph.font.color.rgb = RGBColor(*color)[K
          return shape[K
[K
