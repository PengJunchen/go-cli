      func update(path string) {[K
       r,err := zip.OpenReader(path); must(err)[K
       var buf bytes.Buffer; w := zip.NewWriter(&buf); found := false[K
       for _,f := range r.File {[K
        if f.Name != "ppt/slides/slide4.xml" { must(w.Copy(f)); continue }[K
        rd,err := f.Open(); must(err); data,err := io.ReadAll(rd); must(err); must(rd.Close())[K
        if !bytes.Contains(data,[]byte(esc(oldStatus))) { panic("slide 4 status missing") }[K
        found = true[K
        if oldStatus == releaseStatus { must(w.Copy(f)); continue }[K
        data = bytes.Replace(data,[]byte(esc(oldStatus)),[]byte(esc(releaseStatus)),1)[K
        out,err := w.CreateHeader(&f.FileHeader); must(err); _,err = out.Write(data); must(err)[K
       }[K
       must(w.Close()); must(r.Close()); if !found { panic("slide 4 missing") }[K
       if oldStatus != releaseStatus { must(os.WriteFile(path,buf.Bytes(),0644)) }[K
      }[K
