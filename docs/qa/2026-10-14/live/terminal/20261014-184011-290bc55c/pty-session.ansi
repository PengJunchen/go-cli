     func update(path string) {[K
      z,err:=zip.OpenReader(path); must(err)[K
      var buf bytes.Buffer; out:=zip.NewWriter(&buf); found:=false[K
      for _,f:=range z.File {[K
       if f.Name!="ppt/slides/slide4.xml" { must(out.Copy(f)); continue }[K
       r,err:=f.Open(); must(err); data,err:=io.ReadAll(r); must(err); must(r.Close())[K
       if !bytes.Contains(data,[]byte(oldStatus)) { panic("slide 4 old status missing") }[K
       data=bytes.Replace(data,[]byte(oldStatus),[]byte(releaseStatus),1); found=true[K
       h:=f.FileHeader; w,err:=out.CreateHeader(&h); must(err); _,err=w.Write(data); must(err)[K
      }[K
      must(out.Close()); must(z.Close()); if !found { panic("slide 4 missing") }; must(os.WriteFile(path,buf.Bytes(),0644))[K
     }[K
