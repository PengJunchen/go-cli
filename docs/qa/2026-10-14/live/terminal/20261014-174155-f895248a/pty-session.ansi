     func update(path string) {[K
      z,err := zip.OpenReader(path); must(err)[K
      var out bytes.Buffer[K
      w := zip.NewWriter(&out)[K
      found := false[K
      for _,f := range z.File {[K
       if f.Name != "ppt/slides/slide4.xml" { must(w.Copy(f)); continue }[K
       r,e := f.Open(); must(e); b,e := io.ReadAll(r); must(e); must(r.Close())[K
       if !bytes.Contains(b,[]byte(esc(oldStatus))) { panic("slide 4 old status missing") }[K
       b = bytes.Replace(b,[]byte(esc(oldStatus)),[]byte(esc(releaseStatus)),1)[K
       h := f.FileHeader; dst,e := w.CreateHeader(&h); must(e); _,e = dst.Write(b); must(e); found = true[K
      }[K
[24A


  view truncated · details 96-115/137 · ↑/↓ PgUp/PgDn[K
      }[K
      if !found { panic("slide 4 missing") }[K
      must(w.Close()); must(z.Close())[K
      must(os.WriteFile(path,out.Bytes(),0644))[K
     }[K
     func verify(path string) {[K
